{
  "name": "@portal-360/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/**/*.test.js",
    "auth:generate": "pnpm exec auth generate",
    "auth:migrate": "pnpm exec auth migrate",
    "authorization:migrate": "tsx src/authorization/migrate.ts",
    "business:migrate": "tsx src/business/migrate.ts",
    "authorization:bootstrap-admin": "tsx src/authorization/bootstrap-admin.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.0.2",
    "@nestjs/core": "12.0.2",
    "@nestjs/platform-express": "12.0.2",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "better-auth": "^1.7.5",
    "dotenv": "^17.4.2",
    "kysely": "^0.29.6",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "auth": "1.7.5",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
