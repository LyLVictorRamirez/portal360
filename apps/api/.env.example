# Required by Better Auth. Do not commit a populated .env file.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000

# Optional. Defaults to 8 and accepts a value between 8 and 128.
AUTH_PASSWORD_MIN_LENGTH=8

# Configure all SMTP variables to enable email delivery.
# In development, leaving them empty logs the email link instead.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
