{
  "name": "portal-360",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.4.1"
  },
  "scripts": {
    "dev": "corepack pnpm --parallel --stream --filter \"./apps/*\" run dev",
    "lint": "corepack pnpm --filter \"./apps/*\" run lint",
    "typecheck": "corepack pnpm --filter \"./apps/*\" run typecheck",
    "test": "corepack pnpm --filter \"./apps/*\" run test",
    "build": "corepack pnpm --filter \"./apps/*\" run build",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript-eslint": "8.70.0"
  }
}
